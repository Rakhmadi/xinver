{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "xinver",
  "version": "0.1.0",
  "identifier": "com.rakhmadi-dalimunthe.xinver",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "xinver - Simple Inventory Management System",
        "maximized": true
      }
    ],
    "security": {
        "csp": "default-src 'self'; img-src 'self' asset: https://asset.localhost http://asset.localhost blob: data:;",
        "assetProtocol": {
          "enable": true,
          "scope": ["**"]
        }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/logo/32x32.png",
      "icons/logo/128x128.png",
      "icons/logo/128x128@2x.png",
      "icons/logo/icon.icns",
      "icons/logo/icon.ico"
    ]
  }
}
